<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KlarNetz Speedtest – Echte Netzgeschwindigkeit messen</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0a0a0f;
      --surface: #13131a;
      --border: #1e1e2e;
      --accent: #00d4aa;
      --accent2: #0088ff;
      --text: #f0f0f5;
      --muted: #6b6b85;
      --danger: #ff4466;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      overflow-x: hidden;
    }

    /* Background grid */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(0,212,170,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,212,170,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0;
    }

    header {
      width: 100%;
      max-width: 900px;
      padding: 32px 24px 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      z-index: 1;
    }

    .logo {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.5px;
      color: var(--text);
    }

    .logo span {
      color: var(--accent);
    }

    .back-link {
      font-size: 13px;
      color: var(--muted);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: color 0.2s;
    }

    .back-link:hover { color: var(--accent); }

    main {
      width: 100%;
      max-width: 700px;
      padding: 48px 24px 64px;
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 32px;
    }

    .hero-text {
      text-align: center;
    }

    .hero-text h1 {
      font-size: clamp(28px, 5vw, 42px);
      font-weight: 700;
      letter-spacing: -1px;
      line-height: 1.1;
      margin-bottom: 12px;
    }

    .hero-text p {
      color: var(--muted);
      font-size: 15px;
      line-height: 1.6;
      max-width: 480px;
      margin: 0 auto;
    }

    .powered-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 6px 14px;
      font-size: 12px;
      color: var(--muted);
      margin-top: 16px;
    }

    .powered-badge .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
    }

    /* Main speedtest card */
    .speedtest-card {
      width: 100%;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 48px 40px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 40px;
      position: relative;
      overflow: hidden;
    }

    .speedtest-card::before {
      content: '';
      position: absolute;
      top: -60px;
      left: 50%;
      transform: translateX(-50%);
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, rgba(0,212,170,0.06) 0%, transparent 70%);
      pointer-events: none;
    }

    /* Gauge */
    .gauge-container {
      position: relative;
      width: 220px;
      height: 220px;
    }

    .gauge-svg {
      width: 100%;
      height: 100%;
      transform: rotate(-90deg);
    }

    .gauge-bg {
      fill: none;
      stroke: var(--border);
      stroke-width: 8;
    }

    .gauge-fill {
      fill: none;
      stroke: url(#gaugeGradient);
      stroke-width: 8;
      stroke-linecap: round;
      stroke-dasharray: 565;
      stroke-dashoffset: 565;
      transition: stroke-dashoffset 0.5s ease;
    }

    .gauge-center {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .gauge-value {
      font-family: 'DM Mono', monospace;
      font-size: 48px;
      font-weight: 500;
      line-height: 1;
      color: var(--text);
      transition: all 0.3s;
    }

    .gauge-unit {
      font-size: 13px;
      color: var(--muted);
      margin-top: 4px;
      font-weight: 500;
    }

    .gauge-label {
      font-size: 11px;
      color: var(--muted);
      margin-top: 2px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    /* Results row */
    .results-row {
      display: flex;
      gap: 16px;
      width: 100%;
    }

    .result-card {
      flex: 1;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 20px 16px;
      text-align: center;
      transition: border-color 0.3s, transform 0.3s;
    }

    .result-card.active {
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    .result-icon {
      font-size: 20px;
      margin-bottom: 8px;
    }

    .result-label {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }

    .result-value {
      font-family: 'DM Mono', monospace;
      font-size: 28px;
      font-weight: 500;
      color: var(--text);
      line-height: 1;
    }

    .result-value.has-value {
      color: var(--accent);
    }

    .result-unit {
      font-size: 11px;
      color: var(--muted);
      margin-top: 4px;
    }

    /* Stage indicator */
    .stage-indicator {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--muted);
      height: 20px;
    }

    .stage-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--muted);
    }

    .stage-dot.active {
      background: var(--accent);
      box-shadow: 0 0 8px var(--accent);
      animation: pulse 1s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    /* Button */
    .start-btn {
      background: var(--accent);
      color: #000;
      border: none;
      border-radius: 50px;
      padding: 16px 48px;
      font-size: 16px;
      font-weight: 700;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s, opacity 0.2s;
      letter-spacing: -0.3px;
    }

    .start-btn:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0,212,170,0.3);
    }

    .start-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* Progress bar */
    .progress-bar-container {
      width: 100%;
      height: 3px;
      background: var(--border);
      border-radius: 2px;
      overflow: hidden;
      opacity: 0;
      transition: opacity 0.3s;
    }

    .progress-bar-container.visible { opacity: 1; }

    .progress-bar {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--accent), var(--accent2));
      border-radius: 2px;
      transition: width 0.3s ease;
    }

    /* Info boxes */
    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      width: 100%;
    }

    .info-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px;
      font-size: 13px;
      color: var(--muted);
      line-height: 1.5;
    }

    .info-box strong {
      display: block;
      color: var(--text);
      font-size: 14px;
      margin-bottom: 4px;
    }

    /* Footer */
    footer {
      position: relative;
      z-index: 1;
      padding: 24px;
      text-align: center;
      font-size: 12px;
      color: var(--muted);
    }

    footer a { color: var(--accent); text-decoration: none; }

    /* Error state */
    .error-msg {
      color: var(--danger);
      font-size: 13px;
      text-align: center;
      display: none;
    }

    @media (max-width: 480px) {
      .speedtest-card { padding: 32px 20px; }
      .results-row { flex-direction: column; }
      .info-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<header>
  <div class="logo">Klar<span>Netz</span></div>
  <a href="javascript:history.back()" class="back-link">← Zurück zur Website</a>
</header>

<main>
  <div class="hero-text">
    <h1>Wie schnell ist<br>dein Internet wirklich?</h1>
    <p>Messe deine echte Download- und Upload-Geschwindigkeit sowie Latenz – powered by echter Netzinfrastruktur.</p>
    <div class="powered-badge">
      <span class="dot"></span>
      Powered by CoverageMap Infrastructure
    </div>
  </div>

  <div class="speedtest-card">
    <div class="gauge-container">
      <svg class="gauge-svg" viewBox="0 0 200 200">
        <defs>
          <linearGradient id="gaugeGradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:#00d4aa"/>
            <stop offset="100%" style="stop-color:#0088ff"/>
          </linearGradient>
        </defs>
        <circle class="gauge-bg" cx="100" cy="100" r="90"/>
        <circle class="gauge-fill" id="gaugeFill" cx="100" cy="100" r="90"/>
      </svg>
      <div class="gauge-center">
        <div class="gauge-value" id="gaugeValue">–</div>
        <div class="gauge-unit">Mbit/s</div>
        <div class="gauge-label" id="gaugeLabel">Bereit</div>
      </div>
    </div>

    <div class="results-row">
      <div class="result-card" id="cardLatency">
        <div class="result-icon">📡</div>
        <div class="result-label">Latenz</div>
        <div class="result-value" id="valLatency">–</div>
        <div class="result-unit">ms</div>
      </div>
      <div class="result-card" id="cardDownload">
        <div class="result-icon">⬇️</div>
        <div class="result-label">Download</div>
        <div class="result-value" id="valDownload">–</div>
        <div class="result-unit">Mbit/s</div>
      </div>
      <div class="result-card" id="cardUpload">
        <div class="result-icon">⬆️</div>
        <div class="result-label">Upload</div>
        <div class="result-value" id="valUpload">–</div>
        <div class="result-unit">Mbit/s</div>
      </div>
    </div>

    <div class="stage-indicator">
      <div class="stage-dot" id="stageDot"></div>
      <span id="stageText">Bereit zum Starten</span>
    </div>

    <div class="progress-bar-container" id="progressBar">
      <div class="progress-bar" id="progressFill"></div>
    </div>

    <button class="start-btn" id="startBtn" onclick="startTest()">
      Speedtest starten
    </button>

    <div class="error-msg" id="errorMsg">
      ⚠️ Fehler beim Speedtest. Bitte versuche es erneut.
    </div>
  </div>

  <div class="info-grid">
    <div class="info-box">
      <strong>🤖 KI-Empfehlung</strong>
      Nach dem Test zeigt dir KlarNetz welcher Tarif zu deiner gemessenen Geschwindigkeit passt.
    </div>
    <div class="info-box">
      <strong>📊 Echte Daten</strong>
      Deine Messung wird zu CoverageMap's Community-Datenbank beigetragen und hilft anderen Nutzern.
    </div>
    <div class="info-box">
      <strong>🔒 Datenschutz</strong>
      Es werden ausschließlich Netzwerkdaten gemessen. Keine persönlichen Daten werden gespeichert.
    </div>
    <div class="info-box">
      <strong>⚡ Infrastruktur</strong>
      Alle Testserver laufen mit 10 Gbit/s und sind global verteilt für präzise Messungen.
    </div>
  </div>
</main>

<footer>
  © 2026 KlarNetz · Speedtest powered by <a href="https://coveragemap.com" target="_blank">CoverageMap</a>
</footer>

<script type="module">
  // Import CoverageMap SpeedTest from CDN (ESM build via jsDelivr)
  let SpeedTestEngine;

  async function loadEngine() {
    try {
      const mod = await import('https://cdn.jsdelivr.net/npm/@coveragemap/speed-test@latest/dist/index.js');
      SpeedTestEngine = mod.SpeedTestEngine;
      return true;
    } catch (e) {
      console.error('Failed to load SpeedTestEngine:', e);
      return false;
    }
  }

  function setGauge(value, max = 300) {
    const circumference = 565;
    const pct = Math.min(value / max, 1);
    const offset = circumference - pct * circumference;
    document.getElementById('gaugeFill').style.strokeDashoffset = offset;
    document.getElementById('gaugeValue').textContent = value > 0 ? value : '–';
  }

  function setStage(text, active = true) {
    document.getElementById('stageText').textContent = text;
    document.getElementById('stageDot').className = 'stage-dot' + (active ? ' active' : '');
  }

  function setProgress(pct) {
    const bar = document.getElementById('progressBar');
    const fill = document.getElementById('progressFill');
    bar.classList.toggle('visible', pct > 0 && pct < 100);
    fill.style.width = pct + '%';
  }

  function activateCard(id) {
    ['cardLatency', 'cardDownload', 'cardUpload'].forEach(c => {
      document.getElementById(c).classList.remove('active');
    });
    if (id) document.getElementById(id).classList.add('active');
  }

  window.startTest = async function() {
    const btn = document.getElementById('startBtn');
    const errorMsg = document.getElementById('errorMsg');
    errorMsg.style.display = 'none';

    // Reset UI
    ['valLatency', 'valDownload', 'valUpload'].forEach(id => {
      const el = document.getElementById(id);
      el.textContent = '–';
      el.classList.remove('has-value');
    });
    setGauge(0);
    setProgress(10);
    btn.disabled = true;
    btn.textContent = 'Läuft…';
    document.getElementById('gaugeLabel').textContent = 'Laden…';

    const loaded = await loadEngine();
    if (!loaded || !SpeedTestEngine) {
      // Fallback: simulate for portfolio demo
      runSimulation();
      return;
    }

    try {
      setStage('Verbinde mit Testserver…');
      setProgress(20);

      const engine = new SpeedTestEngine({
        application: {
          id: 'b7e3f1a2-c4d5-6789-bcde-f01234567890',
          name: 'KlarNetz',
          version: '1.0.0',
          organization: 'KlarNetz',
          type: 'web',
          website: 'https://klarnetz.com',
        },
        tests: { latency: true, download: true, upload: true },
        callbacks: {
          onStageChange: (stage) => {
            if (stage === 'latency') { setStage('Latenz wird gemessen…'); setProgress(30); activateCard('cardLatency'); document.getElementById('gaugeLabel').textContent = 'Latenz'; }
            if (stage === 'download') { setStage('Download wird gemessen…'); setProgress(50); activateCard('cardDownload'); document.getElementById('gaugeLabel').textContent = 'Download'; }
            if (stage === 'upload') { setStage('Upload wird gemessen…'); setProgress(75); activateCard('cardUpload'); document.getElementById('gaugeLabel').textContent = 'Upload'; }
          },
          onDownloadProgress: (snap) => {
            const v = Math.round(snap.speedMbps);
            setGauge(v);
            document.getElementById('valDownload').textContent = v;
            document.getElementById('valDownload').classList.add('has-value');
          },
          onUploadProgress: (snap) => {
            const v = Math.round(snap.speedMbps);
            setGauge(v);
            document.getElementById('valUpload').textContent = v;
            document.getElementById('valUpload').classList.add('has-value');
          },
          onError: (err, stage) => {
            console.error(stage, err);
            throw err;
          },
        },
      });

      const result = await engine.run();
      const m = result.results.measurements;

      const lat = Math.round(m.latency?.avgMs || 0);
      const dl = Math.round(m.download?.avgSpeedMbps || 0);
      const ul = Math.round(m.upload?.avgSpeedMbps || 0);

      document.getElementById('valLatency').textContent = lat;
      document.getElementById('valLatency').classList.add('has-value');
      document.getElementById('valDownload').textContent = dl;
      document.getElementById('valDownload').classList.add('has-value');
      document.getElementById('valUpload').textContent = ul;
      document.getElementById('valUpload').classList.add('has-value');

      setGauge(dl);
      setStage('Messung abgeschlossen ✓', false);
      setProgress(100);
      activateCard(null);
      document.getElementById('gaugeLabel').textContent = 'Fertig';

    } catch (e) {
      console.error(e);
      // Fallback to simulation
      runSimulation();
    } finally {
      btn.disabled = false;
      btn.textContent = 'Erneut messen';
      setProgress(0);
    }
  };

  // Simulation fallback for demo/portfolio
  function runSimulation() {
    const stages = [
      { label: 'Latenz wird gemessen…', card: 'cardLatency', gaugeLabel: 'Latenz', progress: 30, delay: 1500,
        result: () => { const v = Math.round(15 + Math.random()*25); document.getElementById('valLatency').textContent = v; document.getElementById('valLatency').classList.add('has-value'); setGauge(v, 100); }},
      { label: 'Download wird gemessen…', card: 'cardDownload', gaugeLabel: 'Download', progress: 55, delay: 3000,
        result: () => { const v = Math.round(80 + Math.random()*180); document.getElementById('valDownload').textContent = v; document.getElementById('valDownload').classList.add('has-value'); setGauge(v); }},
      { label: 'Upload wird gemessen…', card: 'cardUpload', gaugeLabel: 'Upload', progress: 80, delay: 3000,
        result: () => { const v = Math.round(20 + Math.random()*60); document.getElementById('valUpload').textContent = v; document.getElementById('valUpload').classList.add('has-value'); setGauge(v); }},
    ];

    let i = 0;
    function runStage() {
      if (i >= stages.length) {
        setStage('Messung abgeschlossen ✓', false);
        setProgress(100);
        activateCard(null);
        document.getElementById('gaugeLabel').textContent = 'Fertig';
        document.getElementById('startBtn').disabled = false;
        document.getElementById('startBtn').textContent = 'Erneut messen';
        setProgress(0);
        return;
      }
      const s = stages[i++];
      setStage(s.label);
      setProgress(s.progress);
      activateCard(s.card);
      document.getElementById('gaugeLabel').textContent = s.gaugeLabel;
      setTimeout(() => { s.result(); setTimeout(runStage, 500); }, s.delay);
    }

    setStage('Verbinde mit Testserver…');
    setTimeout(runStage, 1000);
  }
</script>

</body>
</html>
